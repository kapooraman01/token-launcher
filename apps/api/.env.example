NODE_ENV=development
PORT=3000

# Matches docker-compose.yml at the repo root
DATABASE_URL=postgresql://launcher:launcher@127.0.0.1:5434/launcher?schema=public

# Chain the indexer reads from. 31337 = local Anvil, 46630 = Robinhood Chain testnet.
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
# Block the factory was deployed in; the indexer starts here.
START_BLOCK=0

INDEXER_ENABLED=true
CONFIRMATIONS=2
INDEXER_POLL_INTERVAL_MS=2000
INDEXER_MAX_BLOCK_RANGE=2000

# Comma-separated list of allowed browser origins. Empty = no cross-origin access.
CORS_ORIGINS=
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# Number of reverse proxies (load balancer, CDN) in front of the API. 0 when exposed directly.
TRUST_PROXY_HOPS=0
