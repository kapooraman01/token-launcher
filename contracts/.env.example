# Required: the account that controls fee settings and pausing. Use a Safe multisig outside local dev.
OWNER=

# Optional overrides. Defaults are the Module 1 proposals.
TARGET_RAISE_WEI=4000000000000000000
PLATFORM_FEE_BPS=95
CREATOR_FEE_BPS=30
ANTI_SNIPE_FEE_BPS=5000
ANTI_SNIPE_DURATION_SECONDS=30
MAX_CREATOR_BUY_BPS=500
MAX_CREATOR_BUY_WEI=500000000000000000

# Graduation into Uniswap v4. Pool fee is in pips: 10000 = 1%.
POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951
POOL_FEE_PIPS=10000
TICK_SPACING=200
POOL_CREATOR_SHARE_BPS=5000
GRADUATION_FEE_WEI=20000000000000000
GRADUATION_REWARD_WEI=1000000000000000
